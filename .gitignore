# Dependencies
# No trailing slash: that form only matches a directory, so a node_modules
# *symlink* (as agents create when sharing installs across worktrees) slips
# past `git add -A` and gets committed.
node_modules

# Compiled seed (generated during Docker build)
prisma/seed.js

# Environment files (secrets)
.env
.env.*
!.env.example
!.env.selfhost.example

# SSH Keys
*.pem
*.key
id_rsa*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Next.js
.next/
out/

# Build
dist/
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Coverage
coverage/

# Misc
*.local
*.deb

*.tsbuildinfo
