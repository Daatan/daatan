# Daatan — self-hosted edition example config
#
# Copy to `.env` and fill in. This file documents the env surface for a
# single-organization self-hosted install. See docs/SELF_HOSTING.md for the
# full guide (IdP setup, storage, backups, upgrades). OIDC SSO, the
# storage drivers (s3/local/minio), and email-domain/invite access gating are
# all live; SAML (via a Jackson OIDC bridge) is the remaining auth item.

# ─── Required ────────────────────────────────────────────────────────────────
# Postgres connection (the bundled compose sets this for you via POSTGRES_PASSWORD).
DATABASE_URL=postgresql://daatan:change-me-strong-password@postgres:5432/daatan
POSTGRES_PASSWORD=change-me-strong-password

# Public base URL of this install (used for auth callbacks; APP_URL falls back to it).
NEXTAUTH_URL=https://forecast.your-org.example
# 32+ char random secret — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32

# ─── Edition & branding ──────────────────────────────────────────────────────
DAATAN_EDITION=self_hosted
# Canonical/SEO/branding base URL (defaults to NEXTAUTH_URL when unset). Consumed from Phase 3.
APP_URL=https://forecast.your-org.example
# White-label (defaults to Daatan when unset). Consumed from Phase 3.
APP_NAME=Acme Forecasting
# APP_LOGO_URL=https://forecast.your-org.example/logo.svg
EMAIL_FROM=Acme Forecasting <noreply@your-org.example>

# ─── Authentication ──────────────────────────────────────────────────────────
# SaaS-style Google OAuth (optional in self-host). Leave unset to disable Google.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
#
# Enterprise SSO via generic OIDC (Azure AD / Okta / Keycloak / Workspace).
# The "SSO" sign-in button appears when all three are set. Set the callback URL
# at your IdP to ${APP_URL}/api/auth/callback/oidc.
# OIDC_ISSUER=https://login.your-org.example/realms/main
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Acme SSO
# Emails promoted to ADMIN on sign-in (comma-separated) — your admin bootstrap.
# OIDC_ADMIN_EMAILS=admin@your-org.example
#
# ─── Access gating ───────────────────────────────────────────────────────────
# Self-host closes public (password) signup by default — employees sign in via
# SSO above. Set to 'true' only if you want an open password-signup form too.
# SELF_HOST_OPEN_SIGNUP=false
#
# Restrict every sign-in (SSO and password) to your company's email domain(s),
# comma-separated. Strongly recommended: this is what keeps outsiders out even
# if your IdP federation is misconfigured. Leave unset for no restriction.
# ALLOWED_EMAIL_DOMAINS=your-org.example

# ─── Storage (uploads / avatars) ─────────────────────────────────────────────
# 's3' (AWS), 'local' (filesystem — set STORAGE_LOCAL_PATH + mount a volume),
# or 'minio' (self-hosted S3-compatible — set S3_ENDPOINT). See docs/SELF_HOSTING.md §5.
STORAGE_DRIVER=s3
UPLOADS_BUCKET_NAME=
# S3_ENDPOINT=https://minio.your-org.example   # for MinIO / S3-compatible
# STORAGE_LOCAL_PATH=/data/uploads             # for STORAGE_DRIVER=local
AWS_REGION=eu-central-1

# ─── AI features (OFF by default — the LLM key is the switch) ────────────────
# Configure ONE LLM provider to turn on AI-assisted features (Express forecast,
# "Guess Chances", AI extract & tag-suggest). No key → those surfaces are hidden
# and the app is a pure manual forecasting tool. OpenRouter is the easy default
# (one key, many models); or use Google Gemini, or a local Ollama.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://ollama:11434
#
# "Analyze" (the search-backed co-forecaster) ALSO needs a search backend — the
# hosted Oracle. Without it, Express still works (LLM-only) but Analyze stays hidden.
# ORACLE_URL=
# ORACLE_API_KEY=
#
# ENABLE_AI_FEATURES=true is an explicit override (normally unnecessary — a key
# is enough). External prediction-market import (Polymarket / Kalshi):
# ENABLE_EXTERNAL_MARKETS=false

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_APP_VERSION=selfhost
