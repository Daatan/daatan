// Prisma Schema for DAATAN
// Forecast/Prediction Market Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  USER
  BOT
  RESOLVER
  APPROVER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String? // Avatar URL from Google
  avatarUrl     String? // Custom uploaded avatar URL from S3
  password      String? // bcrypt hash; null for Google-only accounts

  // Custom profile fields
  username           String? @unique
  slug               String? @unique // URL-friendly identifier (e.g., "john-doe")
  website            String?
  twitterHandle      String?
  emailNotifications Boolean @default(true)
  preferredLanguage  String  @default("en") @db.VarChar(10) // ISO 639-1 code (en, he, etc.)
  isPublic           Boolean @default(true)
  // Show the experimental AI-panel member lines on forecast charts (docs/LASSO.md §8).
  // Off by default: the panel is a hidden source, opt-in per user via Settings. Read
  // server-side in the forecast page loader, so it takes effect without re-login.
  showAiPanel        Boolean @default(false) @map("show_ai_panel")

  // Roles
  role UserRole @default(USER)

  // Scoring
  rs Float @default(100) // Reputation Score (starts at 100)

  // Glicko-2 expertise rating
  mu                 Float @default(1500) // skill estimate (Glicko-1 scale)
  sigma              Float @default(350) // rating deviation — high = uncertain
  volatility         Float @default(0.06) // erraticism of skill changes
  totalPredictions   Int   @default(0)
  correctPredictions Int   @default(0)

  // ELO head-to-head rating
  eloRating Float @default(1500) @map("elo_rating")

  // Bot flag
  isBot Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts Account[]
  sessions Session[]

  // Bot relation
  botConfig BotConfig?

  // Prediction system relations
  predictions         Prediction[] // Predictions authored by user
  commitments         Commitment[] // User's commitments
  resolvedPredictions Prediction[] @relation("ResolvedBy")

  // Bot rejection tracking
  rejectedBotTopics BotRejectedTopic[]

  // Per-tag skill ratings
  tagRatings UserTagRating[]

  // Express Forecast attempt audit log
  forecastCreationAttempts ForecastCreationAttempt[]

  // Oracle calls this user (or bot) triggered
  oracleCallLogs OracleCallLog[]

  // Comments & reactions
  comments         Comment[]
  commentReactions CommentReaction[]

  // Notifications
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]

  // Manual number-rating feedback (daatan#1223) — Telegram 👍/👎 ratings this user cast
  evidencePoolFeedback EvidencePoolArticleFeedback[]

  // Leaderboard sort indexes — ORDER BY ... LIMIT N becomes a scan without these
  @@index([rs(sort: Desc)])
  @@index([eloRating(sort: Desc)])
  @@index([mu(sort: Desc)])
  @@index([correctPredictions(sort: Desc)])
  @@index([isBot])
  @@map("users")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Single-use signup invites for the self-hosted edition (the non-SSO onboarding
// path). `token` stores the SHA-256 of the raw token, never the raw value, so a
// DB read can't be replayed. Consumed by stamping `acceptedAt`. Intentionally
// minimal — email-binding, expiry and per-invite roles are additive later.
model Invite {
  id         String    @id @default(cuid())
  token      String    @unique // SHA-256 hex of the raw token
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@map("invites")
}

// Admin-editable runtime configuration for the self-hosted edition (brand name,
// /about content, OpenRouter key). A row OVERRIDES the matching .env value;
// when no row exists the env (or a hardcoded default) is used, so SaaS — which
// never writes rows — is byte-identical to before. Single-tenant key/value;
// the value is stored as text (the OpenRouter key lives in the operator's own
// DB and is never echoed back through the API).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ============================================
// NEWS ANCHORS (Context for predictions)
// ============================================

model NewsAnchor {
  id String @id @default(cuid())

  // Source information (snapshot - immutable after creation)
  url         String    @db.VarChar(2000)
  urlHash     String    @unique @db.VarChar(64) // SHA-256 hash for deduplication
  title       String    @db.VarChar(500)
  source      String?   @db.VarChar(200) // e.g., "Reuters", "BBC"
  publishedAt DateTime?

  // Snapshot of article content at time of anchor creation
  snippet  String? @db.Text // First ~500 chars of article
  imageUrl String? @db.VarChar(2000)

  createdAt DateTime @default(now())

  // Relations
  predictions Prediction[]

  @@index([createdAt])
  @@map("news_anchors")
}

// ============================================
// TAGS (Categorization)
// ============================================

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(50) // e.g., "Politics", "AI", "Crypto"
  slug      String   @unique @db.VarChar(50) // e.g., "politics", "ai", "crypto"
  createdAt DateTime @default(now())

  predictions      Prediction[]
  userTagRatings   UserTagRating[]
  punditTagRatings PunditTagRating[]

  @@map("tags")
}

// Per-tag ELO/Glicko-2 rating for a tracked pundit/outlet (news-indexer Person,
// not a daatan User — pundits don't commit/stake, their signal is evidence-pool
// stance attributed to their bylines). Same formula and shape as UserTagRating,
// computed by a parallel replay over EvidencePoolArticle instead of Commitment —
// see src/lib/services/pundit-rating.ts. personName is denormalized from
// news-indexer's person.canonical_name so consumers don't need a cross-DB join.
model PunditTagRating {
  id         String  @id @default(cuid())
  personId   String  @map("person_id") @db.VarChar(64)
  personName String? @map("person_name") @db.VarChar(200)
  tagId      String
  tag        Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  elo        Float @default(1500)
  mu         Float @default(1500)
  sigma      Float @default(350)
  volatility Float @default(0.06)

  totalPredictions   Int @default(0) @map("total_predictions")
  correctPredictions Int @default(0) @map("correct_predictions")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([personId, tagId])
  @@index([tagId])
  @@map("pundit_tag_ratings")
}

model UserTagRating {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  elo        Float @default(1500)
  mu         Float @default(1500)
  sigma      Float @default(350)
  volatility Float @default(0.06)

  updatedAt DateTime @updatedAt

  @@unique([userId, tagId])
  @@index([tagId])
  @@map("user_tag_ratings")
}

// ============================================
// PREDICTIONS (New system)
// ============================================

enum OutcomeType {
  BINARY // will happen / won't happen
  MULTIPLE_CHOICE // one option out of N
  NUMERIC_THRESHOLD // metric crosses a defined value
}

enum PredictionStatus {
  DRAFT // Not yet published
  ACTIVE // Published, accepting commitments
  PENDING // Deadline passed, awaiting resolution
  PENDING_APPROVAL // Bot created, awaiting human review
  RESOLVED_CORRECT // Resolved as correct
  RESOLVED_WRONG // Resolved as wrong
  VOID // Invalidated (canceled, rule issues, abuse)
  UNRESOLVABLE // Cannot determine outcome (conflicting sources)
}

// Temporal-model metadata (retro/docs/TEMPORAL_MODEL_PLAN.md). Classified once
// at forecast creation (LLM) + one-shot backfill for pre-existing forecasts.
enum ClaimDirection {
  ARRIVAL // true only if the event HAPPENS by the deadline
  SURVIVAL // true if the event does NOT happen / a state persists
  NONE // no temporal direction
}

enum ClaimArchetype {
  DIFFUSE // event can occur any day in the window — the only archetype v1 prices
  SCHEDULED // outcome determined at a known moment (election, ruling date)
  THRESHOLD // a measurable quantity crossing a stated bar
  NONE // anything else / unclassified
}

model Prediction {
  id String @id @default(cuid())

  // Author
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // News context (optional but encouraged)
  newsAnchorId String?
  newsAnchor   NewsAnchor? @relation(fields: [newsAnchorId], references: [id])

  // Prediction content
  claimText        String  @db.VarChar(500) // The testable statement (canonical = English)
  slug             String? @unique // URL-friendly identifier (e.g., "bitcoin-100k-2026")
  detailsText      String? @db.Text // Additional conditions/context
  tags             Tag[]
  // Detected source language of the author's input, ISO 639-1. Null = legacy /
  // unknown (assumed English). When not English, claimText/detailsText/
  // resolutionRules are canonicalized to English and the original is kept as a
  // PredictionTranslation row for this language.
  originalLanguage String? @map("original_language") @db.VarChar(10)

  // Outcome definition
  outcomeType    OutcomeType @default(BINARY)
  outcomePayload Json? // Type-specific data (options, threshold, etc.)

  // Resolution rules
  resolutionRules   String?  @db.Text // How to determine outcome
  resolveByDatetime DateTime // Deadline for resolution

  // Source tracking (e.g. 'bot' for bot-created predictions)
  source String? @db.VarChar(50)

  // Bot-generated metadata (populated when source = 'bot')
  sentiment         String?  @db.VarChar(20) // "positive" | "negative" | "neutral"
  confidence        Int? // 0–100
  extractedEntities String[] @default([]) // ["Israel", "Lebanon"]
  consensusLine     String?  @db.Text // "Based on 4 sources, 72% indicate escalation"
  sourceSummary     String?  @db.Text // Aggregated summary from multi-source articles

  // AI forecast 95% CI (0–100). Denormalized from the latest Oracle ContextSnapshot
  // so list endpoints can render the range on cards without a join.
  aiCiLow  Int? @map("ai_ci_low")
  aiCiHigh Int? @map("ai_ci_high")

  // Symmetric AI-confidence flag: true while `confidence` sits at >=90 or <=10.
  // Recomputed on every write to `confidence` (see isAwaitingAiResolution in
  // context.ts) — level-based, not sticky, so it clears itself the moment a
  // later read lands back inside the band. Does NOT change `status`: an ACTIVE
  // forecast stays ACTIVE (staking stays open, news-indexer keeps matching it)
  // — it only adds this forecast to the "Awaiting Resolution" tab alongside
  // deadline-passed (PENDING) ones.
  awaitingAiResolution Boolean @default(false) @map("awaiting_ai_resolution")

  // Temporal-model metadata (retro/docs/TEMPORAL_MODEL_PLAN.md #3.4). NULL
  // classifierVersion = never classified (pre-existing forecast awaiting
  // backfill, or classification failed — fail-open, no glide until retried).
  claimDeadline     DateTime?       @map("claim_deadline") // parsed from claim TEXT, not resolveByDatetime — they diverge
  claimDirection    ClaimDirection? @map("claim_direction")
  claimArchetype    ClaimArchetype? @map("claim_archetype")
  tauLeadDays       Int?            @map("tau_lead_days")
  classifierVersion String?         @map("classifier_version") @db.VarChar(40)
  classifiedAt      DateTime?       @map("classified_at")
  classifierOutput  Json?           @map("classifier_output") // raw {confidence, notes, ...} for audit

  // Semantic embedding for similar-forecast search (pgvector, text-embedding-004, 768-dim)
  embedding Unsupported("vector(768)")?

  // Status & timestamps
  status           PredictionStatus @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  publishedAt      DateTime? // When status changed to ACTIVE
  lockedAt         DateTime? // When first commitment was made
  contextUpdatedAt DateTime? // When the detailsText was last updated via analyze context
  winnersPoolBonus Int              @default(0) @map("winners_pool_bonus")

  // Visibility
  isPublic   Boolean @default(true)
  shareToken String  @unique

  // Resolution data (filled when resolved)
  resolvedAt        DateTime?
  resolvedById      String?
  resolvedBy        User?     @relation("ResolvedBy", fields: [resolvedById], references: [id])
  resolutionOutcome String?   @db.VarChar(50) // "correct", "wrong", "void", "unresolvable"
  evidenceLinks     Json? // Array of evidence URLs
  resolutionNote    String?   @db.Text

  // daatan#1234 check #2: null unless the settlement pin / extreme AI confidence
  // contradicted the outcome just declared (see detectPinContradiction) — then
  // true, since resolvePrediction rejects the request outright when the
  // resolver hasn't explicitly acknowledged the disagreement. Null, not false,
  // when the gate never fired: "not applicable" and "declined" must stay
  // distinguishable for the future calibration-record marking (check #3).
  resolutionOverrodePin Boolean? @map("resolution_overrode_pin")

  // Oracle settlement detection: >=2 independent sources reported the outcome as
  // an accomplished fact (retro settlement pin). Sticky — only ever set true by
  // the snapshot writers; human resolution supersedes it. As of PR #1020, does
  // NOT block new commitments by itself — see getCommitmentLockReason in
  // src/lib/services/commitment.ts.
  settled          Boolean   @default(false)
  settledAt        DateTime? @map("settled_at")
  // Audit for the one path that can un-set the latch (daatan#1498). The admin
  // one-click nulls `settled_at` along with the flag, which left a cleared forecast
  // indistinguishable from one that never latched — the exact ambiguity that made
  // the root cause unfalsifiable from the data. The clear now records itself.
  settledClearedAt DateTime? @map("settled_cleared_at")
  settledClearedBy String?   @map("settled_cleared_by")

  // Single-shot alert dedup for the requote cron (retro
  // docs/TEMPORAL_MODEL_PLAN.md #4 Stage 0). temporal-clock.ts re-fires when
  // this timestamp predates the CURRENT claimDeadline rather than on a plain
  // NULL check, so reclassifying a forecast to a later deadline doesn't
  // permanently silence its alert once that new deadline also passes.
  deadlinePassedAlertAt  DateTime? @map("deadline_passed_alert_at")
  teffProvisionalAlertAt DateTime? @map("teff_provisional_alert_at")
  divergenceAlertAt      DateTime? @map("divergence_alert_at")

  // Single-shot alert dedup for the market-vs-Oracle divergence check (external-
  // market-sync cron). Set when the gap first crosses the threshold; cleared
  // once it closes so a later re-crossing fires again (see checkMarketDivergence).
  marketDivergenceAlertAt DateTime? @map("market_divergence_alert_at")

  // Same fire/re-arm idiom for the settled-drift re-verification sweep
  // (daatan#1490): set when a latched forecast's published probability first
  // walks SETTLED_DRIFT_PTS away from the value its settlement pin published,
  // cleared once the gap closes. Deliberately not settledAt — recordEstimate
  // re-stamps that on every settled write, so it dates the last one, not the pin.
  settledDriftAlertAt DateTime? @map("settled_drift_alert_at")
  // Mirror of the above (daatan#1498): the latest evidence snapshot asserts
  // settlement while `settled` is false. Same fire/re-arm idiom.
  unlatchedPinAlertAt DateTime? @map("unlatched_pin_alert_at")

  // The running Telegram notification for this forecast's news-article matches
  // (daatan#1215). NULL = no notification sent yet. Latest-state, not a log:
  // notifyNewsArticleMatched edits this message in place on a later match
  // instead of spamming a new one, falling back to a fresh send (and
  // overwriting both fields with the new message's) when the edit fails —
  // e.g. the old message is outside Telegram's ~48h edit window or deleted.
  telegramMessageId Int?    @map("telegram_message_id")
  telegramChatId    String? @map("telegram_chat_id")

  // External prediction-market link (opt-in — only some forecasts are linked).
  // Linking is admin-authoritative or via URL import; AI only suggests candidates.
  externalMarketId         String?         @map("external_market_id")
  externalMarket           ExternalMarket? @relation(fields: [externalMarketId], references: [id], onDelete: SetNull)
  externalMarketLinkedAt   DateTime?       @map("external_market_linked_at")
  externalMarketLinkMethod String?         @map("external_market_link_method") @db.VarChar(20) // 'manual' | 'ai-confirmed' | 'imported'

  // daatan#1318: set true when the AI moderation check threw (timeout, provider
  // outage, malformed response) instead of returning a verdict. The content is
  // still published (no hard block on a transient provider error) but flagged
  // so an admin can manually review it — checkContent() never silently treats
  // an error as "checked and clean".
  moderationCheckFailed Boolean @default(false) @map("moderation_check_failed")
  // The linked market asks the OPPOSITE question (e.g. claim "X will not win" vs
  // market "Will X win?"). Per-prediction, not per-market: two forecasts may link
  // the same market in opposite directions. UI plots 100 − price when set.
  externalMarketInverted   Boolean         @default(false) @map("external_market_inverted")

  // Phase 2 of the expertise-rating plan (docs/EXPERTISE_RATING_SYSTEM.md, daatan#1138).
  // Reserved for a denormalized "current" market price (0-1, polarity-adjusted),
  // mirroring the aiCiLow/aiCiHigh denormalization above — not yet populated by any
  // writer; ExternalMarketPriceSnapshot remains the source of truth until a sync path
  // writes here. Commitment.polymarketPrice (the per-commit snapshot used for scoring)
  // is populated at commit time; this field is not.
  polymarketPrice Float? @map("polymarket_price")

  // Relations
  options          PredictionOption[]
  commitments      Commitment[]
  comments         Comment[]
  contextSnapshots ContextSnapshot[]
  relationsFrom    QuestionRelation[]      @relation("QuestionRelationFrom")
  relationsTo      QuestionRelation[]      @relation("QuestionRelationTo")
  promotedFromLatentNodes LatentNode[]     @relation("LatentNodePromoted")
  evidencePool     EvidencePoolArticle[]
  translations     PredictionTranslation[]
  slugAliases      PredictionSlugAlias[]
  oracleCallLogs   OracleCallLog[]
  aiEstimateRuns   AiEstimateRun[]
  aiMemberScores   AiMemberScore[]
  calibrationRecord CalibrationRecord?

  @@index([status])
  @@index([authorId])
  @@index([newsAnchorId])
  @@index([resolveByDatetime])
  @@index([isPublic])
  @@index([externalMarketId])
  @@index([status, isPublic, createdAt])
  @@index([status, isPublic, updatedAt])
  @@map("predictions")
}

// ============================================
// CONTEXT SNAPSHOTS (Timeline of context updates)
// ============================================

model ContextSnapshot {
  id           String     @id @default(cuid())
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  summary String @db.Text
  sources Json // Array of { title, url, source, publishedDate }

  externalProbability Int?    @map("external_probability") // 0–100, AI's probability estimate
  externalReasoning   String? @map("external_reasoning") @db.Text // Brief AI reasoning

  // Full TruthMachine Oracle payload, when the Oracle path produced the probability.
  // Shape: { mean, std, ciLow, ciHigh, articlesUsed,
  //          sources: [{ sourceId, sourceName, url, stance, certainty,
  //                      credibilityWeight, claims }] }
  // mean/std/ciLow/ciHigh are all probability percent (0-100) — the Oracle's raw
  // [-1,1] stance scale is converted before storage (see stanceToPercent). Only the
  // per-source `stance`/`certainty` inside `sources[]` stay on the raw Oracle scale.
  // Null when the LLM-fallback path was taken or Oracle is not configured.
  oracleSnapshot Json? @map("oracle_snapshot")

  // True when this run abstained: the Oracle had no evidence bearing on the claim
  // (off-topic / all-hedged / too thin), so no probability was produced. The UI
  // hides the AI estimate and shows "Insufficient evidence" instead of a number.
  insufficientData Boolean @default(false) @map("insufficient_data")

  // 'evidence' (default; article/analyze/settlement writers) | 'clock' (the
  // requote cron's daily arithmetic-only glide). Clock snapshots are excluded
  // from the visible timeline, from anchor selection, and from the
  // article-dedup check (retro docs/TEMPORAL_MODEL_PLAN.md #4 Stage 0).
  // String, not an enum — Stage D adds more kinds later.
  kind String @default("evidence") @db.VarChar(32)
  // Which path wrote this snapshot: 'creation' | 'analyze' | 'news-indexer' |
  // 'backfill' | 'clock' (the recordEstimate funnel — retro docs/ORACLE_VARIABLES.md
  // §6). Pure provenance; `kind` keeps the pricing semantics (evidence vs clock).
  // Null = row written before the funnel existed.
  origin String? @db.VarChar(32)
  // Which engine produced this estimate: 'v1' | 'v2', mirroring retro's
  // `Provenance.engine` (api/src/forecast_api/models.py). Stepping stone for the
  // paired v1/v2 scoring plan (daatan#1617, `Daatan/docs planning/
  // oracle-2-relations-graph.md` §8/§9) — no write path passes 'v2' yet (gated on
  // M4/daatan#1558), so this column changes nothing about current behavior.
  // Defaulted, unlike `origin`, so every existing and future row reads as v1
  // without a backfill: no engine other than v1 has ever produced a forecast.
  engine String? @default("v1") @db.VarChar(16)
  // retro's `Provenance.schema_version` ("1.0" today) — the wire schema shape a
  // future v2 reader should gate on, per daatan#1617, rather than retro's
  // free-form `/version` semver. Null on every row written before this column
  // existed, and NOT defaulted like `engine`: unlike "which engine", "which wire
  // schema" genuinely wasn't recorded for those rows.
  schemaVersion String? @map("schema_version") @db.VarChar(16)
  // Oracle articles_used behind this estimate — evidence volume for a future
  // overwrite policy. Null when unknown (legacy, LLM-fallback, clock rows).
  articlesUsed Int? @map("articles_used")
  // Provenance for kind='clock': { engineVersion, cause, pLast, tLast, tEff, c, direction }.
  // On an abstention (any kind): { abstain: { reason, poolSize } } — why the run declined and
  // over how big a pool (daatan#1473). Both were previously produced and only logged, so an
  // abstention could not be diagnosed after the fact.
  meta Json?

  // F17 (daatan#1236): true when this write's probability moved by at least
  // MATERIAL_CHANGE_PTS from the current evidence anchor (or there is no prior
  // anchor yet) — i.e. it carries new information. A push whose only article
  // was gatekeeper-rejected recomputes the same, unchanged pool and writes the
  // same probability again; that write still happens (audit trail, no
  // check-then-act dedup — see saveNewsIndexerMatch), but is excluded from
  // anchor selection so it can't reset the glide clock's t_last. Default true
  // so every pre-existing row (and every non-evidence/clock write) stays
  // anchor-eligible — this column changes nothing about historical behavior.
  materialChange Boolean @default(true) @map("material_change")

  // F17 (daatan#1236): newest publish time among the sources behind this
  // estimate (max of oracleSnapshot.sources[].publishedAt, falling back to
  // sources[].publishedDate), not the time this row was written. Lets the
  // glide clock anchor to when the evidence actually happened rather than
  // when it was (re-)computed — a backfill over old articles must not look
  // fresh to the clock. Null when unavailable/unparseable; callers fall back
  // to createdAt.
  evidenceAt DateTime? @map("evidence_at")

  createdAt DateTime @default(now())

  @@index([predictionId, createdAt])
  @@map("context_snapshots")
}

/// One resolved binary, frozen at resolution time, so system calibration stops
/// being an ad-hoc research query (daatan#1233).
///
/// Measuring calibration today means lateral joins over context_snapshots ×
/// predictions, re-derived by hand each time — which is why it had been measured
/// exactly once (2026-08-01: Brier 0.298 over 17 scorable pairs, worse than
/// always-50%, and a CI-width-vs-error correlation of −0.07). With this row the
/// reliability curve, Brier-by-horizon, the CI-honesty check and the glide
/// backtest all rebuild themselves on every resolution.
///
/// Written AFTER the resolution transaction commits, deliberately: a defect in
/// calibration bookkeeping must never be able to roll back a resolution. A
/// missing row is a gap in a research table; a rolled-back resolution is lost
/// user-facing state.
///
/// Nothing here is derived-and-stored: Brier, log score and calibration bins are
/// all computable from `pFinal` + `outcome`, so they are not columns. What IS
/// stored is what cannot be recovered later — the published numbers as of
/// specific instants, which the glide keeps overwriting.
model CalibrationRecord {
  id           String     @id @default(cuid())
  predictionId String     @unique
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  /// 'correct' | 'wrong'. Void/unresolvable never produce a record — there is
  /// no outcome to score against.
  outcome    String   @db.VarChar(16)
  resolvedAt DateTime @map("resolved_at")

  /// The last published probability before resolution, 0–100, and when it was
  /// published. INCLUDES kind='clock' rows: the glide's requote is what the
  /// page actually showed, and scoring the system means scoring what it said.
  /// `pFinalKind`/`pFinalOrigin` are what let a fit separate "the evidence said
  /// this" from "the clock said this" after the fact.
  pFinal       Int?      @map("p_final")
  pFinalAt     DateTime? @map("p_final_at")
  pFinalKind   String?   @map("p_final_kind") @db.VarChar(32)
  pFinalOrigin String?   @map("p_final_origin") @db.VarChar(32)

  /// The Oracle's own interval at that instant, 0–100, and whether it was a
  /// settlement pin rather than a pooled estimate. The CI-honesty check is the
  /// point: audit F16 predicts these widths carry no risk information, and the
  /// first measurement (r = −0.07) agreed.
  ciLow          Float?   @map("ci_low")
  ciHigh         Float?   @map("ci_high")
  settledAtFinal Boolean? @map("settled_at_final")

  /// The same published probability as of 7 and 30 days before resolution —
  /// Brier-by-horizon, i.e. whether the system was right early or only at the
  /// end. Null when the forecast did not exist, or carried no estimate, that
  /// far back.
  p7d    Int?      @map("p_7d")
  p7dAt  DateTime? @map("p_7d_at")
  p30d   Int?      @map("p_30d")
  p30dAt DateTime? @map("p_30d_at")

  /// How much of this forecast's history was clock glide vs. actual evidence —
  /// the denominator for the glide backtest.
  clockSnapshots    Int @default(0) @map("clock_snapshots")
  evidenceSnapshots Int @default(0) @map("evidence_snapshots")

  /// Set when the machine and the human resolver read the question differently
  /// (daatan#1234) — e.g. a claim saying "in 2025" resolved against a 2027
  /// deadline, where a confident pin was recorded as a catastrophic miss on a
  /// question that was ambiguous rather than mis-forecast. Such pairs must be
  /// annotatable and excludable from fits instead of silently poisoning them.
  disputed     Boolean @default(false)
  disputeNote  String? @map("dispute_note") @db.Text

  createdAt DateTime @default(now())

  @@index([resolvedAt])
  @@map("calibration_records")
}

/// Per-forecast evidence pool (retro docs/ORACLE_VARIABLES.md §6 part 2, foundation
/// layer only — 2026-07-09). analyze/news-indexer/backfill shadow-write their
/// per-source signals here in ADDITION to (not instead of) their existing
/// ContextSnapshot/Prediction writes; nothing reads this table to compute an
/// estimate yet — that's a separate follow-up. One row per (predictionId,
/// urlHash): the row IS the extraction cache, so re-discovering an already-pooled
/// article on a later run updates its signal in place.
/// pending: claimed for extraction, not yet complete (or a prior attempt failed
/// and is being retried). complete: contentHash reflects the currently-stored
/// stance/claims. failed: the last extraction attempt errored — statusReason
/// carries a short machine-readable cause; eligible for retry once stale.
enum EvidencePoolStatus {
  PENDING
  COMPLETE
  FAILED
}

model EvidencePoolArticle {
  id           String     @id @default(cuid())
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  url     String @db.VarChar(2000)
  urlHash String @map("url_hash") @db.VarChar(64) // hashUrl() — same normalization as NewsAnchor
  title   String? @db.VarChar(500)
  source  String? @db.VarChar(200) // outlet/domain, e.g. "reuters.com"
  // Resolved author identity from news-indexer (/articles/by-url): the byline plus the
  // cross-platform person it resolves to. Lets elections attribute a source to a tracked
  // commentator by joining on personId/personName instead of re-matching author strings
  // (Phase 2, docs/MATCHING_ARCHITECTURE.md). All nullable; forward-populated on write,
  // backfilled separately. personName is news-indexer's person.canonical_name.
  author     String? @db.VarChar(200)
  personId   String? @map("person_id") @db.VarChar(64)
  personName String? @map("person_name") @db.VarChar(200)
  // Resolved outlet identity from news-indexer (/articles/by-url), same shape and provenance
  // as personId/personName above — an exact match against news-indexer's outlet.name (no
  // alias table on that side; sources.yaml's `name` IS the outlet's canonical identity). Lets
  // elections attribute a source to a tracked outlet by joining on outletId instead of
  // re-matching TRACKED_SOURCES. All nullable; forward-populated on write, backfilled separately.
  outletId   String? @map("outlet_id") @db.VarChar(64)
  outletName String? @map("outlet_name") @db.VarChar(200)
  publishedDate String? @map("published_date") // as reported by the source; not always a full ISO date

  // Content fingerprint (hash of title+snippet as pushed by the discovering
  // path — the only fields news-indexer's webhook actually sends; no full
  // article body reaches daatan) — distinguishes "same URL, same content,
  // safe to skip re-extraction" from "same URL, content changed (e.g. a
  // live-blog update), legitimately new evidence." Null on rows written
  // before this field existed; treated as always-changed on next encounter,
  // no backfill needed (the gap self-heals, 286 rows at introduction).
  contentHash String? @map("content_hash") @db.VarChar(64)
  // The snippet the discovering path pushed, kept so a RETRY can re-send the same
  // text the original attempt had (daatan#1232). Without it the retry sweep re-pushed
  // title-only (`snippet: ''`), i.e. strictly LESS text than the attempt that already
  // failed — for a Telegram row whose only content IS the snippet that made the second
  // null near-deterministic, and the terminal `oracle_null_final` stamp a self-fulfilling
  // prophecy rather than a genuine re-test. Nullable; rows written before this existed
  // stay null and the sweep falls back to title-only for them, exactly as before.
  snippet String? @db.VarChar(2000)
  // Claim/completion lifecycle for the atomic extraction gate (evidence-pool.ts
  // claimArticleForExtraction/completeArticleExtraction/failArticleExtraction).
  // Lets two near-simultaneous discoveries of the same (predictionId, url) —
  // news-indexer's delivery is at-least-once — serialize on a single Postgres
  // create-then-conditional-updateMany instead of racing a separate
  // findFirst-then-create (the bug this replaces: two writers both read
  // "not a duplicate" before either commits, both call the extractor, both
  // persist a ContextSnapshot — confirmed in prod, 7 cases, 3 with conflicting
  // stance from the same near-simultaneous article).
  status       EvidencePoolStatus @default(COMPLETE)
  statusReason String?            @map("status_reason") @db.VarChar(64) // set only when status='failed'

  // Extracted signal, same shape as EnrichedOracleSource — stance/certainty stay on
  // the Oracle's raw [-1,1]/[0,1] scale (see oracle-snapshot.ts), not converted here.
  stance               Float?
  certainty            Float?
  credibilityWeight    Float?  @map("credibility_weight")
  claims               Json    @default("[]")
  settled              Boolean?
  // The settlement anchor (retro PR #291): strict YYYY-MM-DD as emitted and
  // validated by retro's extractor — the outcome's occurrence date for a
  // positive settlement, the foreclosing event's date for a negative one, null
  // when legitimately undated (post-deadline expiry). Sent back on
  // /pool/aggregate so aggregation-time revalidation can re-check the
  // settlement vote on every recompute; a plain String pass-through like
  // publishedDate — daatan imposes no date semantics of its own.
  settlementEventDate String? @map("settlement_event_date")
  quantitativeEstimate Float?  @map("quantitative_estimate")
  // Retro's resolved evidence_class weight (S2 cutover, retro PR #249/#251) —
  // the `class_weight[evidence_class]`/certainty-fallback value already
  // computed server-side. Nothing reads this yet; without it a future
  // recompute-over-pool cutover would silently fall back to certainty for
  // every already-pooled article.
  evidenceWeight Float? @map("evidence_weight")
  // Graded topic relevance [0,1] the gatekeeper assigned (retro
  // SourceSignal.relevance_score) — its square multiplies aggregation weight
  // (Layer C). Never previously captured anywhere in daatan's pipeline; without
  // it a recompute would treat every pooled article as fully on-topic.
  relevanceScore Float? @map("relevance_score")
  // The per-article relevance bar in force when this row was admitted
  // (retro#393/#394, ForecastResponse.relevance_bar, PR retro#404) — 0.0 means
  // no bar was applied, which is /forecast's behaviour today. SHADOW / storage
  // only, like `authorLean` and `factSignal`: nothing reads this yet. It exists
  // so that once the bar moves off 0.0, a backtest or recompute can tell which
  // admission regime produced each row — a property of the row, not derivable
  // after the fact. Null on rows written before this existed and on the
  // `/pool/aggregate` recompute path (compute-only, never re-extracts, and the
  // bar isn't returned there). No backfill: the value was never recorded and
  // must not be invented.
  relevanceBar Float? @map("relevance_bar")
  // Which model/prompt produced this row's stance/certainty (daatan#1604/retro#627) —
  // retro's ProvenanceModels on the /forecast response that wrote this row. Model fields
  // are litellm ids (e.g. "claude-haiku-4-5"); *PromptVersion is a hand-bumped human label
  // (see retro/docs/PROMPT_VERSIONS.md — only as reliable as whoever edited the prompt
  // remembering to bump it); *PromptHash is a SHA-256 of the actual rendered prompt,
  // computed automatically, so it stays correct even when the version label goes stale.
  // Lets a since-fixed prompt bug be traced in stored data instead of being invisible.
  // SHADOW / storage only, like relevanceBar: nothing reads these yet. Null on the
  // `/pool/aggregate` recompute path (no LLM call, retro's ProvenanceModels docstring:
  // "all null on a pool recompute"). Rows that completed extraction before these columns
  // existed were one-time backfilled to the literal sentinel "pre-v1" (migration
  // 20260824130000, COMPLETE rows only) rather than a date-inferred guess — Oracle's
  // SIGHUP-reload deploys and live/batch checkout drift make "merge date" an unreliable
  // proxy for "which prompt actually ran," so a specific historical version/hash was
  // deliberately not invented. "pre-v1" means only "predates provenance capture."
  extractorModel          String? @map("extractor_model")
  extractorPromptVersion  String? @map("extractor_prompt_version")
  extractorPromptHash     String? @map("extractor_prompt_hash")
  gatekeeperModel         String? @map("gatekeeper_model")
  gatekeeperPromptVersion String? @map("gatekeeper_prompt_version")
  gatekeeperPromptHash    String? @map("gatekeeper_prompt_hash")
  // The article's most common evidence_class among its extracted claims
  // (retro PR #255) — reported_fact | cited_probability | cited_share |
  // reporting | opinion, or null if unclassified. Needed by the credibility
  // feedback loop to exclude opinion-class articles from the
  // resolution-outcome signal (evidence_weight alone can't distinguish
  // opinion from a low-certainty unclassified article). Plain string, not a
  // Prisma enum — matches `origin`'s convention for this model.
  evidenceClass String? @map("evidence_class") @db.VarChar(32)

  // The BYLINE author's OWN directional forecast of the event (retro #308/#309):
  // authorLean ∈ [-1,1] (+1 the author expects it to happen, -1 expects not, 0
  // weighs both sides), authorLeanCertainty ∈ [0,1] (how firmly they commit).
  // Both null when the author only reported facts or relayed others' views.
  // SHADOW / author-scoring lane ONLY — deliberately kept out of the estimate:
  // nothing in aggregation reads these (the un-fusing work, docs/DATABASE.md).
  // Populated from the Oracle's per-source SourceSignal.author_lean; null on rows
  // written before this field existed and on the `/pool/aggregate` recompute path
  // (compute-only, never re-extracts). No backfill without a reset→retry sweep —
  // pool rows are a contentHash extraction cache.
  authorLean          Float? @map("author_lean")
  authorLeanCertainty Float? @map("author_lean_certainty")

  // The FACT-lane counterpart of `stance` (retro #313, Phase 2 of the un-fusing
  // work): what the REPORTED FACTS alone imply about the event, separated from
  // author assertion/framing. `factSignal` ∈ [-1,1] — claim-weighted MEAN over
  // the article's fact-bearing claims (the SAME reduction as `stance`, so the
  // same reduction as `stance`); the four facets qualify
  // the DOMINANT (max |fact_signal|) claim:
  // `eventActors`/`eventTarget` name that fact's actor→target dyad (the actor-pair
  // check, #303), `isOccurrence` marks the event ITSELF vs a precursor/escalation,
  // `verified` marks an independently-reported fact vs an interested party's claim,
  // `facet` marks whether that fact ANNOUNCES the event, DENIES it, or is NEITHER
  // (retro#354 D2a) — input to a possible future magnitude check (retro#483).
  // DIAGNOSTIC lane, not a pricing lane in waiting: the estimator cutover these
  // columns were written for is RETIRED (retro#533, 2026-08-15 — corr(stance,
  // fact_signal) 0.905 on precursor rows; `Daatan/docs/decisions.md`). Nothing in
  // daatan reading them is the steady state, not a waiting room; they earn their
  // keep on retro's side (extraction-time caps, recomputed there — never read back
  // from here) and here as the per-claim audit surface.
  // All null when no scored claim carried a fact_signal (e.g. pure opinion).
  // Free-text facets (`eventActors`/`eventTarget`) are unbounded (no VarChar cap)
  // so an over-long LLM value can never fail this shadow write. SHADOW / estimator
  // lane ONLY — like `authorLean`, nothing in aggregation or the recompute reads
  // these, and they are never sent to `/pool/aggregate`. Additive, nullable, no
  // backfill: populated only on NEW extractions (pool rows are a contentHash
  // cache); live `stance` and the current estimate are untouched.
  factSignal   Float?   @map("fact_signal")
  eventActors  String?  @map("event_actors")
  eventTarget  String?  @map("event_target")
  isOccurrence Boolean? @map("is_occurrence")
  verified     Boolean?
  facet        String?  @db.VarChar(16)

  // The per-claim layer behind every extracted scalar above (F1/F15, daatan#1235
  // + retro#364). Each element carries one claim's own stance, certainty,
  // specificity, kind, evidence_class, quantitative_estimate, settled, event_date,
  // fact_signal and the four fact facets — see retro's ClaimDetail model, which is
  // the wire shape stored here verbatim.
  //
  // Why this column exists: everything above is a REDUCTION. A multi-article claim
  // set was collapsed into five article-level scalars computed over five different
  // claim subsets, and this is where the inputs to those reductions physically died
  // — unrecoverably. Without it there is no retroactive backtesting (we cannot
  // re-score history we never kept), no per-claim credibility attribution, no way to
  // measure extractor instability over time, and nothing for a shadow pool to read.
  //
  // Two collapses are only visible here: `evidenceClass` above is the article's most
  // COMMON class (mixed-class articles are unattributable above this layer), and the
  // fact facets above ride from the single DOMINANT claim (so a lone over-cap
  // interested-party claim diluted by in-contract siblings is invisible — retro#378).
  //
  // SHADOW / storage only — like `authorLean` and `factSignal`, nothing in
  // aggregation reads this and it is never sent to `/pool/aggregate`; the estimator
  // keeps its eight-scalar whitelist. Additive, nullable, NO BACKFILL: for rows
  // written before this existed the per-claim data is gone and must not be
  // fabricated. Populated only on new extractions (pool rows are a contentHash
  // extraction cache), and deliberately never NULLED by an update that merely omits
  // it (see addArticlesToPool — the daatan#1237 failure mode).
  claimsDetail Json? @map("claims_detail")

  // Which path most recently (re-)extracted this article: 'analyze' |
  // 'news-indexer' | 'backfill'. Overwritten on re-discovery — provenance of the
  // latest signal, not a history of every path that ever cited this article.
  origin String @db.VarChar(32)

  // Admin override (daatan #1068, "Evidence pool" panel on the forecast page).
  // Not yet enforced by any computation — the recompute-over-pool cutover is
  // still open — so this only records the decision ahead of that cutover.
  // Shadow-writes never touch this field once an admin has set it.
  excluded Boolean @default(false)

  addedAt   DateTime @default(now()) @map("added_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Version chain for a real versioning fix (daatan#1267/#1352 Phase 2,
  // write path landed daatan#1381). `origin` above used to document the gap
  // this closes: re-extraction used to overwrite a pool row in place, so a
  // correction replaced its claims instead of producing a new linked
  // version — claimArticleForExtraction now inserts a new row instead.
  // supersedesId is a BACKWARD pointer: a new correction row carries
  // supersedesId = the row it replaced, so the ORIGINAL row in a chain has
  // supersedesId = null. version is a plain counter starting at 1.
  // supersededAt is the head/not-head marker: null means this row is still
  // current, a timestamp means it was replaced (and records when) — see the
  // migration for why this needs its own column rather than reusing
  // supersedesId (a predicate can't express "no other row supersedes me"
  // from one row's own columns). Readers that aggregate or display "the
  // pool" must filter to `supersededAt: null` (evidence-pool.ts's
  // CURRENT_VERSION_ONLY) or a superseded row double-counts alongside its
  // replacement.
  supersedesId String?              @map("supersedes_id")
  supersedes   EvidencePoolArticle? @relation("EvidencePoolArticleSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy EvidencePoolArticle[] @relation("EvidencePoolArticleSupersedes")
  version      Int                  @default(1)
  supersededAt DateTime?            @map("superseded_at")

  // Manual number-rating feedback (daatan#1223)
  ratingPrompts ArticleRatingPrompt[]

  // NOT `@@unique([predictionId, urlHash])` — a version chain needs multiple
  // historical rows per URL. Real uniqueness (exactly one non-superseded row
  // per (predictionId, urlHash)) is enforced by a partial unique index the
  // Prisma DSL can't express; see the 20260811120000 migration. This plain
  // index just supports the query planner for that filter.
  @@index([predictionId, supersededAt])
  @@index([supersedesId])
  @@index([predictionId])
  @@map("evidence_pool_articles")
}

// One value per number a rater can flag as wrong on a notifyNewsArticleMatched
// Telegram notification. AUTHOR_LEAN/FACT_SIGNAL/EVIDENCE_CLASS/CREDIBILITY cover
// the Signal Lanes judgment-lane line (daatan#1222) ahead of it seeing real rating
// volume, so no follow-up migration is needed once that line gets tapped often.
enum NumberFeedbackField {
  STANCE
  RELEVANCE
  SIMILARITY
  PROBABILITY // covers probability/previous/ciLow/ciHigh as one "the Oracle move" bucket
  AUTHOR_LEAN
  FACT_SIGNAL
  EVIDENCE_CLASS
  CREDIBILITY
  OTHER
}

// One SENT rating-prompt Telegram message (1-5 rating buttons, daatan#1223) — a dedicated
// message separate from the main edited-in-place notifyNewsArticleMatched notification
// (daatan#1219 made that one edit-in-place per prediction, so it no longer maps 1:1 to
// one article/push; this table restores that 1:1 mapping for rating purposes). Created
// at SEND time, before any tap, so a frozen reference to what was actually shown
// survives however long the message sits unrated. `contextSnapshotId` points at the
// ContextSnapshot this same push created (saveNewsIndexerMatch) — stance/relevance/
// authorLean/factSignal/evidenceClass/credibilityWeight/probability/ciLow/ciHigh are
// all reachable through its `oracleSnapshot` JSON, and ContextSnapshot rows are never
// mutated after creation, so this stays a true point-in-time reference even if
// EvidencePoolArticle itself is later re-extracted. `snapshotSimilarity` (the embedding
// match %) is captured directly since it isn't persisted anywhere else.
model ArticleRatingPrompt {
  id                    String              @id @default(cuid())
  evidencePoolArticleId String
  evidencePoolArticle   EvidencePoolArticle @relation(fields: [evidencePoolArticleId], references: [id], onDelete: Cascade)
  predictionId          String // denormalized — lets "all prompts for prediction X" skip a join
  contextSnapshotId     String? @map("context_snapshot_id") // ContextSnapshot has no back-relation; plain id
  snapshotSimilarity    Float?  @map("snapshot_similarity")

  messageChatId String @map("message_chat_id")
  messageId     Int    @map("message_id")

  createdAt DateTime @default(now()) @map("created_at")

  feedback EvidencePoolArticleFeedback[]

  @@unique([messageChatId, messageId])
  @@index([evidencePoolArticleId])
  @@map("article_rating_prompts")
}

// Fire/re-arm state for the evidence-health digest (daatan#1478). One row per
// condition that is CURRENTLY firing; see the 20260818120000 migration for why
// this can't be telegram.ts's in-memory canNotify() (it resets on every deploy,
// and these conditions persist for days). Reconciled wholesale on each run:
// keys absent from the run's active set are deleted, which re-arms them.
model EvidenceHealthAlert {
  id      String   @id @default(cuid())
  key     String   @unique @db.VarChar(200)
  firedAt DateTime @default(now()) @map("fired_at")

  @@map("evidence_health_alerts")
}

// Dedup ledger for the twice-weekly evidence-second-opinion cron (daatan#1636):
// detector 1 (cheap-vs-expensive disagreement on one article) and detector 2
// (same-source stance drift) share this table, same reconcile-wholesale shape
// as EvidenceHealthAlert — keys absent from a run's active set are deleted,
// re-arming that case for the next run instead of alerting on it forever.
model EvidenceSecondOpinionAlert {
  id      String   @id @default(cuid())
  key     String   @unique @db.VarChar(200)
  firedAt DateTime @default(now()) @map("fired_at")

  @@map("evidence_second_opinion_alerts")
}

// Per-UTC-day counter of AI-panel OpenRouter 402 (payment) failures (daatan#1504).
// The 402s only surfaced in app logs, which the DB-driven evidence-health digest
// can't read — so the sweep records them here at the call site and the digest
// alerts when any landed inside its lookback window. All four OpenRouter panel
// members fail together on credit exhaustion (2026-08-19: 572 × 402 in six
// minutes = total panel outage, daatan#1491), so a count per day plus the last
// occurrence is all the digest needs. One row per bad day; empty table = no
// recent payment failures.
model PanelPaymentFailure {
  day        String   @id @db.VarChar(10) // UTC calendar day, "YYYY-MM-DD"
  count      Int
  lastSeenAt DateTime @map("last_seen_at")
  lastModel  String   @map("last_model") @db.VarChar(200)

  @@map("panel_payment_failures")
}

// Human-in-the-loop rating of one ArticleRatingPrompt — a 1-5 verdict plus which
// specific number was wrong (daatan#1223). One row per (prompt, rater): a user can
// change their mind by tapping another button, which just updates their own row.
// Accumulates until there's enough signal to inform edits to retro's extractor prompts
// (AUTHOR_LEAN/FACT_SIGNAL sections in pipeline/src/tm/extractor.py).
//
// Any channel member can vote BY DESIGN — rater identity is the tapper's Telegram
// user id (always present on a callback_query, needs no setup). raterUserId is
// optional enrichment via TELEGRAM_ADMIN_MAP (Telegram id → User.id), never a gate.
model EvidencePoolArticleFeedback {
  id              String              @id @default(cuid())
  promptId        String
  prompt          ArticleRatingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  raterTelegramId String              @map("rater_telegram_id")
  raterName       String?             @map("rater_name") // display name captured from the tap
  raterUserId     String?
  rater           User?               @relation(fields: [raterUserId], references: [id], onDelete: SetNull)

  // 1 (worst) .. 5 (best). Plain Int, not an enum — keeps AVG()/threshold queries natural
  // for the later analysis pass. Validated in the webhook (1-5) before this is written.
  rating        Int
  flaggedFields NumberFeedbackField[] @default([]) @map("flagged_fields")
  note          String?              @db.Text // captured via reply-to-message text

  // private DM to the rater, sent only when rating <= 2 (see LOW_RATING_THRESHOLD)
  drilldownChatId    String? @map("drilldown_chat_id")
  drilldownMessageId Int?    @map("drilldown_message_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([promptId, raterTelegramId])
  @@map("evidence_pool_article_feedback")
}

// ============================================
// EXTERNAL PREDICTION MARKETS (Polymarket / Kalshi link + price history)
// ============================================

enum MarketProvider {
  POLYMARKET
  KALSHI
}

/// A cached external prediction market (Polymarket or Kalshi) that one or more
/// Daatan forecasts link to. Metadata + price are refreshed by the
/// external-market-sync cron. `embedding` powers suggest-on-create (Phase D).
model ExternalMarket {
  id         String         @id @default(cuid())
  provider   MarketProvider @default(POLYMARKET)
  externalId String         @map("external_id") // provider's stable id (Polymarket conditionId / Kalshi ticker)
  slug       String         @map("slug") // URL slug / ticker
  url        String         @map("url") // canonical market URL
  question   String         @db.Text

  outcomes Json // e.g. ["Yes","No"] — outcome labels in price order

  endDate         DateTime? @map("end_date")
  resolved        Boolean   @default(false)
  resolvedOutcome String?   @map("resolved_outcome") @db.VarChar(100)
  lastSyncedAt    DateTime? @map("last_synced_at")

  // Semantic embedding of `question` for suggest-on-create (pgvector, 768-dim).
  embedding Unsupported("vector(768)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions Prediction[]
  snapshots   ExternalMarketPriceSnapshot[]

  @@unique([provider, externalId])
  @@index([slug])
  @@map("external_markets")
}

/// Point-in-time YES probability for a linked market (drives the history chart).
/// Keyed by market, not prediction — multiple forecasts may link the same market.
model ExternalMarketPriceSnapshot {
  id       String         @id @default(cuid())
  marketId String         @map("market_id")
  market   ExternalMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)

  probability Int // 0–100, the YES outcome price

  createdAt DateTime @default(now())

  @@index([marketId, createdAt])
  @@map("external_market_price_snapshots")
}

// ============================================
// AI PANEL (multi-model estimates — docs/LASSO.md)
// ============================================

/// One sweep of the AI panel over one forecast: every member's estimate, taken at
/// the same instant. Commitments reference the RUN (not a scalar probability), so
/// each member's number at commit time stays recoverable — that is what makes
/// per-model Brier possible, and what lets a member added later be backfilled
/// without migrating `commitments`.
///
/// `inputHash` is the date-gate. The panel prompt carries no article text, so the
/// only input that changes over a forecast's life is the date; when the hash is
/// unchanged we skip the whole sweep and the previous run stays current. The
/// unique index on (predictionId, inputHash) makes the cron idempotent.
model AiEstimateRun {
  id           String     @id @default(cuid())
  predictionId String     @map("prediction_id")
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  /// sha256 of claim + rules + resolveBy + UTC day + promptVersion + roster signature.
  /// Grounded-scoped forecasts (docs/LASSO.md §9a) additionally fold in the grounded
  /// prompt's version and the context snapshot's fingerprint.
  inputHash String @map("input_hash") @db.VarChar(64)

  /// The article set retrieved for this run's grounded-indexer members, frozen at run
  /// creation (`PanelContextSnapshot`): a completion pass re-asks against exactly this,
  /// never a fresh retrieval. Null = ungrounded-only run.
  contextSnapshot Json? @map("context_snapshot")

  createdAt DateTime @default(now())

  estimates   AiEstimate[]
  commitments Commitment[]

  @@unique([predictionId, inputHash])
  @@index([predictionId, createdAt])
  @@map("ai_estimate_runs")
}

/// One member's probability within one run.
///
/// This table NEVER feeds `Prediction.confidence` / `aiCiLow` / `aiCiHigh`, and the
/// panel never calls `recordEstimate()`. That isolation is structural: the gauge
/// (`Speedometer.tsx`) reads only those columns, so no panel value can reach the
/// needle, the high-confidence Telegram alert, `awaitingAiResolution`, or any
/// ELO/Glicko/leaderboard path. See docs/LASSO.md §1.
model AiEstimate {
  id    String        @id @default(cuid())
  runId String        @map("run_id")
  run   AiEstimateRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// OpenRouter slug, e.g. "x-ai/grok-4.3". String, not enum — adding a member
  /// must never require a migration.
  model String @db.VarChar(64)
  /// 'ungrounded', or 'grounded-indexer' for the news-fed twins (docs/LASSO.md §9a).
  mode  String @db.VarChar(16)
  /// Fingerprint of the prompt template behind this estimate. Member identity is
  /// (model, mode, promptVersion): change the prompt and prior Brier scores stop
  /// being comparable, so this must be stored rather than inferred.
  promptVersion String @map("prompt_version") @db.VarChar(32)

  /// 0–100. Null iff `insufficientData` — the member abstained (claim too vague)
  /// or its call failed. A failure is recorded as an abstention, never as a
  /// substituted answer from another model.
  probability      Int?
  insufficientData Boolean @default(false) @map("insufficient_data")
  /// True when the CALL threw (timeout, provider 5xx, IAM) — the model never saw the
  /// claim. False on a deliberate null: the model answered "too vague". Per-member
  /// stats must not blend provider reliability into model calibration.
  callFailed Boolean @default(false) @map("call_failed")

  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  latencyMs        Int? @map("latency_ms")

  createdAt DateTime @default(now())

  @@unique([runId, model, mode])
  @@index([runId])
  @@map("ai_estimates")
}

/// Matched-time Brier for one panel member on one commitment (docs/LASSO.md §7).
///
/// Written at resolution, one row per (commitment, member): the member's probability in
/// the run current when that user staked, scored against the outcome. Directly comparable
/// to the human's own `Commitment.brierScore` on the same commitment — same claim, same
/// instant, same information — which is the whole point of matched-time.
///
/// `model` is a panel member slug, or the sentinel 'oracle': the Oracle needle at commit
/// time is already on `Commitment.aiProbabilityAtCommit`, so scoring it here as a member
/// costs zero extra calls and answers "does the Oracle beat the panel, or the crowd?".
///
/// Isolation holds: this is written only at resolution and read only for the AI
/// leaderboard. Nothing here feeds a user's RS, ELO, or Glicko rating.
model AiMemberScore {
  id           String     @id @default(cuid())
  predictionId String     @map("prediction_id")
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  commitmentId String     @map("commitment_id")
  commitment   Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  model      String @db.VarChar(64)
  // Member identity's mode axis: a grounded-indexer twin shares its sibling's model
  // string, so model alone would collide. 'sentinel' for the oracle/market benchmark
  // rows — not null, because a nullable member of a compound unique breaks upsert.
  mode       String @default("ungrounded") @db.VarChar(16)
  brierScore Float  @map("brier_score") // (probability − outcome)², both on 0–1
  // Part of member identity (docs/LASSO.md §6): scores from different prompt versions
  // are not comparable and the leaderboard groups by it. Null for the 'oracle'/'market'
  // sentinels, which have no prompt.
  promptVersion String? @map("prompt_version") @db.VarChar(32)

  createdAt DateTime @default(now())

  @@unique([commitmentId, model, mode])
  @@index([model])
  @@index([predictionId])
  @@map("ai_member_scores")
}

// ============================================
// PREDICTION OPTIONS (for MC/Numeric)
// ============================================

model PredictionOption {
  id String @id @default(cuid())

  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  text         String @db.VarChar(500)
  displayOrder Int    @default(0)

  // For numeric: threshold value
  numericValue Float?

  // Resolution
  isCorrect Boolean?

  // Relations
  commitments Commitment[]

  @@index([predictionId])
  @@map("prediction_options")
}

// ============================================
// COMMITMENTS (CU Stakes)
// ============================================

model Commitment {
  id String @id @default(cuid())

  // User making commitment
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prediction being committed to
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  // Selected option (for MC/Numeric)
  optionId String?
  option   PredictionOption? @relation(fields: [optionId], references: [id])

  // For binary: true = will happen, false = won't happen
  binaryChoice Boolean?

  // CU committed
  cuCommitted Int // Amount of CU locked
  rsSnapshot  Float // RS at time of commitment

  // Timestamps
  createdAt DateTime @default(now())

  // Probability stated at commit time (0.0-1.0), representing P(YES outcome)
  probability Float?

  // Result (calculated after resolution)
  rsChange   Float? // RS delta after resolution
  brierScore Float? // (probability - outcome)² computed at resolution

  // Competitive scoring fields (snapshotted at commit, computed at resolution)
  communityProbabilityAtCommit Float? @map("community_probability_at_commit")
  aiProbabilityAtCommit        Float? @map("ai_probability_at_commit")
  peerScore                    Float? @map("peer_score")
  aiScore                      Float? @map("ai_score")
  eloChange                    Int?   @map("elo_change")

  // Phase 2 of the expertise-rating plan (docs/EXPERTISE_RATING_SYSTEM.md, daatan#1138).
  // Linked market's YES probability (0-1, polarity-adjusted per
  // Prediction.externalMarketInverted — see marketDisplayProbability) as of commit
  // time, snapshotted from ExternalMarketPriceSnapshot when the forecast has a linked
  // market. Null when unlinked or no snapshot exists yet — never back-filled.
  polymarketPrice Float? @map("polymarket_price")
  // D_KL(user || market) computed at resolution when polymarketPrice is present:
  // p·log(p/q) + (1-p)·log((1-p)/(1-q)), p = user's stated probability, q =
  // polymarketPrice. Rewards surprising-but-correct calls relative to the market
  // consensus. Not yet wired into any ranking formula — storage only (daatan#1138).
  klDivergence Float? @map("kl_divergence")

  // The AI-panel run current at commit time — matched-time Brier (docs/LASSO.md §7).
  // A run FK, NOT a scalar: `aiProbabilityAtCommit` above collapses the Oracle to one
  // number, which is fine because the Oracle IS one number. The panel is many, and a
  // scalar here would destroy per-model scoring at the exact instant we capture it.
  // Null for commits placed before the panel's first run — those drop out of the
  // aggregates the same way a null `brierScore` already does.
  aiRunIdAtCommit String?        @map("ai_run_id_at_commit")
  aiRunAtCommit   AiEstimateRun? @relation(fields: [aiRunIdAtCommit], references: [id], onDelete: SetNull)
  aiMemberScores  AiMemberScore[]
  revisions       CommitmentRevision[]

  // Each user can only commit once per prediction
  @@unique([userId, predictionId])
  @@index([predictionId])
  @@index([userId])
  @@index([aiRunIdAtCommit])
  @@map("commitments")
}

/// Append-only history of a commitment's mutable fields (daatan#1281).
///
/// Written by updateCommitment inside the same transaction, BEFORE each UPDATE: the
/// commitment row stays the current state, these rows hold the prior trajectory —
/// side, stake, RS at write — which an in-place UPDATE otherwise destroys
/// irrecoverably. No backfill: history that predates this table was never recorded.
/// Storage-only; nothing in the product reads it. Deleting a commitment cascades
/// its revisions away with it.
model CommitmentRevision {
  id           String     @id @default(cuid())
  commitmentId String     @map("commitment_id")
  commitment   Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  // Snapshot of the fields updateCommitment can change, plus probability for
  // self-containment (currently written by nothing in the commit path).
  optionId     String?  @map("option_id")
  binaryChoice Boolean? @map("binary_choice")
  cuCommitted  Int      @map("cu_committed")
  probability  Float?
  rsSnapshot   Float    @map("rs_snapshot")

  supersededAt DateTime @default(now()) @map("superseded_at")

  @@index([commitmentId, supersededAt])
  @@map("commitment_revisions")
}

// ============================================
// COMMENTS (Discussion system)
// ============================================

model Comment {
  id String @id @default(cuid())

  // Author
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Content
  text String @db.Text

  // Target
  predictionId String?
  prediction   Prediction? @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  // Threading (for replies)
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete
  deletedAt DateTime?

  // daatan#1318: see Prediction.moderationCheckFailed — same fail-flagged-not-
  // fail-open semantics for comments.
  moderationCheckFailed Boolean @default(false) @map("moderation_check_failed")

  // Relations
  reactions    CommentReaction[]
  translations CommentTranslation[]

  @@index([predictionId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
  @@index([predictionId, createdAt])
  @@index([deletedAt])
  @@map("comments")
}

// ============================================
// COMMENT REACTIONS (likes, etc.)
// ============================================

enum ReactionType {
  LIKE
  INSIGHTFUL
  DISAGREE
}

model CommentReaction {
  id String @id @default(cuid())

  // User who reacted
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Comment being reacted to
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // Reaction type
  type ReactionType

  createdAt DateTime @default(now())

  // Each user can only have one reaction per comment
  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_reactions")
}

// ============================================
// TRANSLATION CACHE
// ============================================

model PredictionTranslation {
  id             String     @id @default(cuid())
  predictionId   String
  prediction     Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  fieldName      String     @db.VarChar(50) // "claimText" | "detailsText" | "resolutionRules"
  language       String     @db.VarChar(10) // ISO 639-1 e.g. "he"
  translatedText String     @db.Text
  // SHA-256 of the source text this translation was produced from. The cache is a
  // hit only when it matches the current source, so an edited field (e.g.
  // detailsText rewritten by a context update) re-translates instead of serving
  // a stale translation. Null on legacy rows → treated as stale (re-translate once).
  sourceHash     String?    @map("source_hash") @db.VarChar(64)
  createdAt      DateTime   @default(now())

  @@unique([predictionId, fieldName, language])
  @@index([language])
  @@map("prediction_translations")
}

// A forecast's previous slug(s), kept after a re-slug (e.g. a non-English slug
// fixed during English canonicalization) so the old URL 308-redirects to the
// current canonical slug instead of 404ing.
model PredictionSlugAlias {
  id           String     @id @default(cuid())
  slug         String     @unique
  predictionId String     @map("prediction_id")
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([predictionId])
  @@map("prediction_slug_aliases")
}

model CommentTranslation {
  id             String   @id @default(cuid())
  commentId      String
  comment        Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  language       String   @db.VarChar(10)
  translatedText String   @db.Text
  createdAt      DateTime @default(now())

  @@unique([commentId, language])
  @@index([language])
  @@map("comment_translations")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  COMMITMENT_RESOLVED // Your committed prediction was resolved
  COMMENT_ON_FORECAST // Someone commented on your forecast
  REPLY_TO_COMMENT // Someone replied to your comment
  NEW_COMMITMENT // Someone committed to your forecast
  MENTION // You were @mentioned in a comment
  SYSTEM // System-wide announcement
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BROWSER_PUSH
  TELEGRAM
}

model Notification {
  id String @id @default(cuid())

  // Recipient
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Content
  type    NotificationType
  title   String           @db.VarChar(200)
  message String           @db.Text
  link    String?          @db.VarChar(500) // Deep link into the app (e.g., /forecasts/abc)

  // Source references (for deduplication and grouping)
  predictionId String? // Related prediction
  commentId    String? // Related comment
  actorId      String? // User who triggered the notification

  // State
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which notification type
  type NotificationType

  // Which channels are enabled for this type
  inApp       Boolean @default(true)
  email       Boolean @default(false)
  browserPush Boolean @default(false)
  telegram    Boolean @default(false)

  @@unique([userId, type])
  @@map("notification_preferences")
}

