model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique @db.VarChar(2000)
  p256dh     String    @db.VarChar(200)
  auth       String    @db.VarChar(100)
  userAgent  String?   @db.VarChar(500)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================
// BOT SYSTEM
// ============================================

enum BotAction {
  CREATED_FORECAST
  VOTED
  SKIPPED
  ERROR
}

model BotConfig {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Persona & prompts (all admin-editable)
  personaPrompt  String @db.Text // Bot's character description
  forecastPrompt String @db.Text // Prompt for creating a forecast from a news item
  votePrompt     String @db.Text // Prompt for deciding whether/how to vote on a forecast

  // News sources (array of RSS URLs)
  newsSources Json // String[]

  // Schedule
  intervalMinutes Int @default(360) // How often to run (in minutes)

  // Activity caps
  maxForecastsPerDay Int @default(3)
  maxVotesPerDay     Int @default(10)

  // Staking
  stakeMin Int @default(10)
  stakeMax Int @default(100)

  // LLM model preference (e.g. "google/gemini-2.5-flash-preview:free")
  modelPreference String @default("google/gemini-2.5-flash-preview:free")

  // Hotness detection thresholds
  hotnessMinSources  Int @default(2) // Min sources to consider hot
  hotnessWindowHours Int @default(6) // Time window for hotness detection

  // Active hours window (UTC). Both null = always active.
  // If set, bot only runs when: hour >= start && hour < end (overnight works: start > end).
  // TODO(stage2-bot-params): enforced in bot-runner.ts runBot()
  activeHoursStart Int?
  activeHoursEnd   Int?

  // Tag focus filter: bot only creates/votes on forecasts with these tags.
  // Empty array = no filter (act on all tags).
  // TODO(stage2-bot-params): enforced in bot-runner.ts processTopics() + runVoting()
  tagFilter Json @default("[]") // String[]

  // Vote bias 0–100: 0 = lean NO, 50 = neutral, 100 = lean YES.
  // Injected into votePrompt at runtime.
  // TODO(stage2-bot-params): injected in bot-runner.ts runVoting() LLM prompt
  voteBias Int @default(50)

  // Enabled action flags — disable phases without removing the bot.
  // TODO(stage2-bot-params): guarded at start of each phase in bot-runner.ts
  canCreateForecasts Boolean @default(true)
  canVote            Boolean @default(true)

  // Auto-approve: if true, bot forecasts go directly to ACTIVE (skip PENDING_APPROVAL).
  autoApprove Boolean @default(false)

  // Approval workflow: require manual approval before staking
  requireApprovalForForecasts Boolean @default(false)

  // Sentiment extraction: extract sentiment/confidence from cluster articles
  enableSentimentExtraction Boolean @default(false)

  // Rejection tracking: track rejected topics to prevent duplicate suggestions
  enableRejectionTracking Boolean @default(false)

  // Metadata display: show extracted metadata (sentiment, entities, etc) on forecasts
  showMetadataOnForecast Boolean @default(false)

  // Rate limiting: max forecasts per hour (0 = unlimited)
  maxForecastsPerHour Int @default(0)

  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  rejectedTopics BotRejectedTopic[]
  runLogs        BotRunLog[]

  @@map("bot_configs")
}

model BotRunLog {
  id    String    @id @default(cuid())
  botId String
  bot   BotConfig @relation(fields: [botId], references: [id], onDelete: Cascade)

  runAt         DateTime  @default(now())
  action        BotAction
  triggerNews   Json? // { title, url, sources: string[] }
  generatedText String?   @db.Text // LLM-generated forecast text (for review)
  forecastId    String? // Prediction ID if forecast was created
  isDryRun      Boolean   @default(false)
  error         String?   @db.Text

  @@index([botId])
  @@index([runAt])
  @@index([botId, action, isDryRun, runAt]) // admin bot-log queries
  @@map("bot_run_logs")
}

// ============================================
// BOT REJECTED TOPICS
// ============================================

model BotRejectedTopic {
  id    String    @id @default(cuid())
  botId String
  bot   BotConfig @relation(fields: [botId], references: [id], onDelete: Cascade)

  keywords    String[] // normalized keyword set of rejected topic
  description String   @db.VarChar(500) // human-readable e.g. "War between Israel and Lebanon"

  rejectedById String
  rejectedBy   User     @relation(fields: [rejectedById], references: [id], onDelete: Cascade)
  rejectedAt   DateTime @default(now())

  @@index([botId])
  @@index([rejectedAt])
  @@map("bot_rejected_topics")
}

// ============================================
// FORECAST CREATION ATTEMPTS (Express Forecast audit log)
// ============================================

enum ForecastAttemptOutcome {
  SUCCESS
  NO_ARTICLES
  MODERATED
  SEARCH_UNAVAILABLE
  GENERATION_FAILED
}

model ForecastCreationAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userInput String                 @db.Text
  isUrl     Boolean                @default(false)
  outcome   ForecastAttemptOutcome
  details   Json? // outcome-specific: {searchedFor,isNonLatin} | {moderationReason} | {searchErrorCode} | {errorMessage}

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([outcome])
  @@index([createdAt(sort: Desc)])
  @@map("forecast_creation_attempts")
}

// ============================================
// CONTEXT TIMINGS
// ============================================

model ContextTiming {
  id        String   @id @default(cuid())
  searchMs  Int
  llmMs     Int
  oracleMs  Int
  totalMs   Int
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("context_timings")
}

enum OracleCallType {
  SEARCH
  FORECAST
  LEADERBOARD
  HEALTH
  SEARCH_HEALTH
  LLM
  FETCH_URL
}

enum OracleCallStatus {
  OK
  EMPTY
  ERROR
}

model OracleCallLog {
  id       String           @id @default(cuid())
  callType OracleCallType   @default(SEARCH)
  // Daatan workflow that triggered the call (e.g. "context-update", "bot-voting").
  // Plain string (not enum) so new sources don't require a migration.
  source   String           @default("legacy")
  status   OracleCallStatus @default(OK)

  // Search engine used: search calls → provider; forecast calls → engine from retro; else null.
  searchEngine String?
  httpStatus   Int?
  // User/bot that triggered the call; null for system/cron.
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Forecast this call relates to, when known (context-update, bot-voting,
  // research). Null for express drafting (no forecast yet), cron, leaderboard.
  predictionId String?
  prediction   Prediction? @relation(fields: [predictionId], references: [id], onDelete: SetNull)

  // Search-specific (null for non-search calls). `query` doubles as the forecast question.
  provider      String?
  providerChain String[]
  query         String?
  resultCount   Int?

  // Why a call failed/came back empty. Plain string (not enum) so new reasons
  // don't need a migration. Transport (daatan-derived): timeout | network |
  // http_5xx | http_4xx. EMPTY (passed through from the Oracle's `reason`):
  // no_search_results | all_articles_off_topic | all_fetches_failed |
  // extraction_errors | no_usable_predictions | no_result | oracle_timeout. Else unknown.
  failureReason       String?
  // True when the caller abandoned the Oracle result and used the LLM fallback.
  fellBackToLlm       Boolean @default(false)
  // The 0–100 probability the LLM fallback produced (set with fellBackToLlm).
  fallbackProbability Int?

  // LLM token usage as reported by the Oracle's `token_usage` response field
  // (docs#57 item 3). Only FORECAST and LLM calls carry it (retro doesn't report
  // usage for SEARCH etc.); null when the Oracle omitted the object or the row
  // predates this column.
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?

  durationMs Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([provider])
  @@index([callType])
  @@index([source])
  @@index([status])
  @@index([userId])
  @@index([predictionId])
  @@map("oracle_call_logs")
}

// Oracle 2.0 storage layer M1 (daatan#1555). A declared relation between two
// questions — STRUCTURE ONLY, no probability: edge weights are a derived
// snapshot layer (M4) that does not exist yet. Written by the signed relation
// typer (retro#574), read by the coherence check. Post-moderated: REJECTED rows
// stay so the typer cannot re-propose a pair a human already refused.
// Design: Daatan/docs planning/oracle-2-harness-and-storage.md §4.1.
enum QuestionRelationKind {
  ALIAS // same question, other wording or language — symmetric
  NESTED_DEADLINE // from ⊂ to: "E by Oct" ⊂ "E by Dec" (ARRIVAL; SURVIVAL reverses)
  THRESHOLD_NESTING // from ⊂ to: P(X>200) ≤ P(X>130)
  MUTUALLY_EXCLUSIVE // Σ ≤ 1 — symmetric
  COMPLEMENT // P(from) + P(to) = 1 — symmetric
  IMPLIES // from ⇒ to
  CONDITIONAL // from is an antecedent of to; `sign` says raises / lowers
  NONE // typer looked, found no constraint — a ledger row, never a graph edge
}

enum QuestionRelationOrigin {
  HUMAN
  DERIVED // from claimDeadline / claimDirection, no model
  EXTRACTED // from an article's conditional claim
  MODEL // proposed by the typer on a cosine + shared-tag candidate pair
}

enum QuestionRelationStatus {
  PROPOSED
  CONFIRMED
  REJECTED // kept — never re-proposed
  MERGED // the two questions were one; alias resolved by moderation
}

model QuestionRelation {
  id               String      @id @default(cuid())
  // Endpoints are polymorphic as of M2 (daatan#1556): exactly one of
  // *PredictionId / *LatentNodeId is set per side (CHECK in the migration), so
  // a shadow forecast (latent node) can sit on either end. The original
  // prediction-prediction unique constraint below is untouched by that change —
  // question-relation.ts's `findUnique` depends on its exact shape.
  fromPredictionId String?     @map("from_prediction_id")
  fromPrediction   Prediction? @relation("QuestionRelationFrom", fields: [fromPredictionId], references: [id], onDelete: Cascade)
  toPredictionId   String?     @map("to_prediction_id")
  toPrediction     Prediction? @relation("QuestionRelationTo", fields: [toPredictionId], references: [id], onDelete: Cascade)
  fromLatentNodeId String?     @map("from_latent_node_id")
  fromLatentNode   LatentNode? @relation("QuestionRelationFromLatent", fields: [fromLatentNodeId], references: [id], onDelete: Cascade)
  toLatentNodeId   String?     @map("to_latent_node_id")
  toLatentNode     LatentNode? @relation("QuestionRelationToLatent", fields: [toLatentNodeId], references: [id], onDelete: Cascade)

  kind      QuestionRelationKind
  sign      Int?                   @db.SmallInt // +1 / -1, CONDITIONAL only (CHECK in the migration)
  createdBy QuestionRelationOrigin @map("created_by")
  status    QuestionRelationStatus @default(PROPOSED)

  typerOutput Json?    @map("typer_output") // verbatim, for audit — classifierOutput precedent
  cosine      Float?
  sharedTag   Boolean? @map("shared_tag")

  decidedBy String?   @map("decided_by")
  decidedAt DateTime? @map("decided_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  variantLatentNodes LatentNode[] @relation("LatentNodeVariantOf")

  // Prediction-prediction uniqueness — shipped M1, unchanged by M2. The three
  // latent-node-involved combinations get their own partial unique indexes in
  // the migration (not representable via @@unique, which has no WHERE clause).
  @@unique([fromPredictionId, toPredictionId, kind])
  @@index([toPredictionId, status])
  @@index([fromPredictionId])
  @@index([toLatentNodeId, status])
  @@index([fromLatentNodeId])
  @@map("question_relations")
}

// Oracle 2.0 storage layer M2 (daatan#1556): a "shadow forecast" — a question
// that exists and is priced but that no one has published. Not a
// PredictionStatus (a Prediction carries author/deadline/share-token/
// resolution-rules and cascades into pools, commitments, snapshots; a latent
// node is one English clause whose commonest fate is merge or rejection).
// No promotion path yet (deferred) — `predictionId`/PROMOTED are on record for
// the shape but nothing sets them today.
// Design: Daatan/docs planning/oracle-2-harness-and-storage.md §4.2.
enum LatentNodeStatus {
  OPEN
  MERGED
  PROMOTED
  REJECTED
}

enum LatentNodeOrigin {
  ARTICLE_ANTECEDENT // linked from an article's extracted conditional claim
  VARIANT // opposite / reworded / other-date version of an existing forecast
  MCP_PROBE // a stateless MCP `forecast` call on a clause with no matching question
  EXPRESS // the drafting wizard — not created by default policy, kept for completeness
}

model LatentNode {
  id     String @id @default(cuid())
  textEn String @map("text_en") @db.VarChar(500)

  // Semantic embedding, same space as predictions.embedding (pgvector, 768-dim).
  // No HNSW index until row count clears ~50k (pgvector memory, see
  // retro retrieval-tooling survey).
  embedding Unsupported("vector(768)")?

  // Same classifier fields/values as Prediction. The resolvability gate is "all
  // three non-null" — enforced by callers, not a DB constraint.
  claimDeadline  DateTime?       @map("claim_deadline")
  claimDirection ClaimDirection? @map("claim_direction")
  claimArchetype ClaimArchetype? @map("claim_archetype")

  // Provenance of the first admitting claim. Maintained by the linking
  // pipeline (v2 steps 2–4, not built yet) — null for nodes created directly
  // through the admin create endpoint.
  fanIn                     Int       @default(0) @map("fan_in")
  firstClaimArticleId       String?   @map("first_claim_article_id")
  firstClaimIndex           Int?      @map("first_claim_index")
  lastSeenAt                DateTime? @map("last_seen_at")

  status       LatentNodeStatus @default(OPEN)
  mergedIntoId String?          @map("merged_into_id")
  mergedInto   LatentNode?      @relation("LatentNodeMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   LatentNode[]     @relation("LatentNodeMerge")

  // Set on promotion (not built yet — see enum comment above).
  predictionId String?     @map("prediction_id")
  prediction   Prediction? @relation("LatentNodePromoted", fields: [predictionId], references: [id])

  // Last stateless Oracle `/forecast` result on the clause — no evidence pool
  // in daatan until promoted.
  priceMean Float?    @map("price_mean")
  priceVar  Float?    @map("price_var")
  pricedAt  DateTime? @map("priced_at")

  origin  LatentNodeOrigin
  // Variants (complement/alias/nested_deadline of an existing forecast) point
  // at the relation row that makes them so — they price off the logical edge,
  // not search, and resolve when the parent resolves.
  variantOfRelationId String?           @map("variant_of_relation_id")
  variantOfRelation   QuestionRelation? @relation("LatentNodeVariantOf", fields: [variantOfRelationId], references: [id])
  // user id, 'model', or 'bot' — free-form, unlike QuestionRelationOrigin.
  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  relationsFrom QuestionRelation[] @relation("QuestionRelationFromLatent")
  relationsTo   QuestionRelation[] @relation("QuestionRelationToLatent")

  @@index([status])
  @@index([mergedIntoId])
  @@map("latent_nodes")
}
