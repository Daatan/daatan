# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive variable files
*.tfvars
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform directories
.terraform/
.terraform.lock.hcl

# Plan files
tfplan
*.tfplan

# Working scratch — state snapshots and captured plan output must never be committed
# (a future state snapshot could carry secrets); tooling downloads stay local too.
terraform_state_tmp.json
plan_output.txt
*.deb

# CLI configuration files
.terraformrc
terraform.rc

